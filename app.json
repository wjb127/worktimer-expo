{
  "expo": {
    "name": "필타임",
    "slug": "worktimer-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      "expo-live-activity",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1052634480432-1gbe1hcid97kssalcensbb5ciorok5nc"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#007AFF"
        }
      ],
      "./plugins/withFmtFix",
      "./plugins/withGoogleModularHeaders",
      "expo-localization",
      "@sentry/react-native/expo"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000214"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.codeatlas.worktimer",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.codeatlas.worktimer",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000214"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "31c0b3a1-6f4a-4b05-ad00-89924a249f68"
      }
    },
    "owner": "gawall"
  }
}
